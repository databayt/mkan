# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/package-lock.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# debug / scratch artifacts — one-off Playwright capture+inspect scripts and
# screenshots from local debugging. Put throwaway scripts in /scratch/.
# (Tracked configs eslint.config.mjs / postcss.config.mjs are NOT matched below.)
/*.png
/capture-*.mjs
/inspect-*.mjs
/compose-*.mjs
/hard-refresh.mjs
/scratch/

# clone skill scratch snapshots
.clone/
