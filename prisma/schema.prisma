// Short-term Booking payment record. Mirrors TransportPayment so the three
// payment verticals (lease / transport / booking) stay consistent. The
// reference flow (Bankak / Cashi / mobile money / bank transfer) parks at
// PendingVerification until an admin reconciles via verifyBookingPayment;
// the card flow (Stripe) advances to Paid via handleStripeWebhook.
model BookingPayment {
  id            Int                  @id @default(autoincrement())
  bookingId     Int
  amount        Float
  method        BookingPaymentMethod
  status        BookingPaymentStatus @default(Pending)
  intentId      String? // Stripe payment_intent id (card path)
  reference     String? // user-supplied wallet/bank reference
  transactionId String? // gateway-issued transaction id
  paidAt        DateTime?
  verifiedAt    DateTime? // admin reconciled the reference
  verifiedBy    String? // admin user id (loose ref, no FK)
  failureCode   String?
  refundedAt    DateTime?
  refundAmount  Float?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  booking       Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([intentId])
  @@index([reference])
}

enum BookingPaymentMethod {
  Card
  Bankak
  Cashi
  MobileMoney
  BankTransfer
  Cash
}

enum BookingPaymentStatus {
  Pending
  PendingVerification
  Paid
  Failed
  Refunded
  PartiallyRefunded
}

/// Fixed-window rate-limit counters — the Postgres fallback used when
/// Upstash Redis isn't configured. Key = "tier:identifier:windowStart";
/// rows expire with the window and are swept opportunistically.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

/// On-demand translation cache for dynamic DB content (listing titles,
/// descriptions, addresses…). Content is stored single-language (Arabic) and
/// the viewer's locale decides what they see — resolved LRU → this table →
/// Google Translate v2 (see src/components/translation/). Global (mkan is not
/// multi-tenant); manual rows (provider="manual") are never overwritten.
model Translation {
  id             String   @id @default(cuid())
  sourceText     String   @db.Text
  sourceLanguage String // "ar" | "en"
  targetLanguage String // "ar" | "en"
  translatedText String   @db.Text
  provider       String   @default("google")
  hitCount       Int      @default(0)
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceText, sourceLanguage, targetLanguage])
  @@index([sourceLanguage, targetLanguage])
  @@index([lastAccessedAt])
  @@map("translation_cache")
}

// ─── Marketplace analytics ──────────────────────────────────────────────────

/// One row per (listing, event type, visitor, day) — a raw event table and a
/// daily rollup at the same time.
///
/// Why not one row per event: the funnel needs "how many people looked at this
/// home", not "how many times a tab was refreshed". Collapsing on the day means
/// a refresh bumps `hits` instead of inventing a second visitor, unique-visitor
/// counts fall out of a plain COUNT, and storage is bounded by
/// (listings × visitors × days) rather than by raw traffic. Weekly/monthly
/// aggregation is a `date_trunc` over `day` with no fan-out.
///
/// `visitorHash` is sha256(dailySalt ‖ ip ‖ user-agent) where the salt is
/// DERIVED (HMAC of a server secret and the date), never random and never
/// stored — see src/lib/analytics/visitor.ts for why a random salt breaks on
/// serverless. It carries no cookie, so it needs no consent gate; it is still
/// pseudonymous personal data and rows are pruned after 90 days.
///
/// `cityKey`/`zoneKey` are denormalised from the listing's Location at write
/// time so zone rollups never have to join through Listing → Location.
model ListingEvent {
  id          Int              @id @default(autoincrement())
  listingId   Int
  type        ListingEventType
  /// Date-only bucket (UTC). The unit of deduplication.
  day         DateTime         @db.Date
  visitorHash String
  /// Set when the visitor was signed in. Null for anonymous traffic, which is
  /// most of it — anonymous visitors still count, they just can't be attributed.
  userId      String?
  /// Raw occurrences within the day. `hits` is depth; the row itself is reach.
  hits        Int              @default(1)
  firstAt     DateTime         @default(now())
  lastAt      DateTime         @default(now())
  cityKey     String?
  zoneKey     String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation("ListingEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([listingId, type, day, visitorHash])
  @@index([type, day])
  @@index([listingId, type, day])
  @@index([cityKey, type, day])
  @@index([zoneKey, type, day])
  @@index([day])
}

/// A physical property viewing, recorded by the host or an admin after it is
/// arranged — mkan is contact-only this phase, so visits are agreed over the
/// phone and logged afterwards rather than self-served by the guest. Unlike
/// ListingEvent this is stateful (it has an outcome), so it gets its own model.
model ListingVisit {
  id           Int          @id @default(autoincrement())
  listingId    Int
  /// Set when the visitor has an account; most phase-1 visits will be a name
  /// and a phone number taken over a call.
  guestUserId  String?
  contactName  String?
  contactPhone String?
  scheduledFor DateTime
  occurredAt   DateTime?
  outcome      VisitOutcome @default(Scheduled)
  notes        String?
  /// Host or admin who logged it. Loose ref, no FK — mirrors
  /// BookingPayment.verifiedBy.
  recordedById String
  /// A three-party viewing (2026-11-01): the tenant, the broker, and the
  /// person from Mkan who meets them there (repName) — the rental agent's task
  /// it came from, and where they meet.
  brokerId     String?
  taskId       String?
  repName      String?
  meetingPoint String?
  /// Reminder marks already sent ("24h", "2h", "after") — the cron sends each once.
  reminders    String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guestUser User?   @relation("ListingVisitGuest", fields: [guestUserId], references: [id], onDelete: SetNull)
  deal      Deal?

  @@index([listingId])
  @@index([listingId, outcome])
  @@index([outcome, scheduledFor])
  @@index([scheduledFor])
}

/// Funnel event types. APPEND-ONLY, like every other enum here — Postgres
/// stores the label on the row, so reordering rewrites history.
///
/// The CONTACT_* values are all "inquiry" for funnel purposes but are kept
/// distinct so the dashboard can show which channel actually works. Today only
/// CONTACT_PHONE_CLICK fires in volume (the product is contact-only); the
/// others exist so the series is continuous when those paths open up.
enum ListingEventType {
  VIEW
  CONTACT_PHONE_REVEAL
  CONTACT_PHONE_CLICK
  CONTACT_MESSAGE
  CONTACT_APPLICATION
}

enum VisitOutcome {
  Scheduled
  Completed
  NoShow
  Cancelled
}

/// One attempt at mastering one listing photo — turning a low-quality host
/// original into a professional real-estate photograph (same property, same
/// reality, better photography). A photo with NO rows is unprocessed: absence
/// is the ORIGINAL state. Rows are append-only history — a retry is a new row
/// with attempt+1, never an overwrite — so "which prompt/model produced the
/// image now live on listing X, and what happened to attempt 1" stays
/// answerable forever. Runbook: docs/image-mastering.md.
model MasteringRun {
  id            String          @id @default(cuid())
  listingId     Int
  /// Position in photoUrls at queue time — display only. The apply step swaps
  /// by originalUrl match, never by index: hosts mutate the array under us.
  photoIndex    Int
  originalUrl   String
  status        MasteringStatus @default(QUEUED)
  attempt       Int             @default(1)
  /// The prompt is compiled and FROZEN at queue time. The canonical prompt
  /// will evolve; what a given image was actually asked for must not change
  /// under it, or the record of why an image looks the way it does is fiction.
  promptVersion String
  prompt        String
  /// Who/what executes the generate step: "nano-banana-web" for the human
  /// Gemini-app lane, a Gemini API model id once the automated lane is funded.
  model         String
  /// Set only together with status MASTERED/UPDATED, never alone.
  masteredUrl   String?
  /// Slack task message (ts + permalink) in #makan-image-mastering.
  slackTs       String?
  slackUrl      String?
  failureReason String?
  humanNote     String?
  queuedAt      DateTime        @default(now())
  assignedAt    DateTime?
  masteredAt    DateTime?
  /// When the mastered URL went live in Listing.photoUrls (status UPDATED).
  appliedAt     DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, originalUrl, attempt])
  @@index([status, queuedAt])
  @@index([listingId, status])
}

/// Mastering lifecycle. UPDATED — not MASTERED — is the finished state:
/// MASTERED means a validated result exists on the CDN; UPDATED means it is
/// live in Listing.photoUrls and mirrored to Twenty. There is no stored
/// STALLED — staleness is computed from state age by master:reconcile, so
/// there is nothing to forget to un-set. APPEND-ONLY like every enum here.
enum MasteringStatus {
  QUEUED
  ASSIGNED
  MASTERED
  UPDATED
  REJECTED
  FAILED
}

/**
 * How a listing's price is quoted.
 */
enum RentPeriod {
  NIGHTLY
  MONTHLY
}

enum AgentTaskStatus {
  RUNNING
  WAITING // waiting on a person (a broker) — resumes when they answer
  DONE
  FAILED
}

/**
 * Who rental-agent chats belong to. Anonymous by default: `keyHash` is the
 * sha256 of the browser's httpOnly `mkan_agent` cookie. Signing in sets
 * `userId` (folding another browser's anonymous profile into it), and from
 * then on the profile opens only with that session. `memory` is what the
 * agent remembers across chats (src/components/agent/memory.ts).
 */
model AgentProfile {
  id           String    @id @default(cuid())
  keyHash      String?   @unique
  userId       String?   @unique
  /// A WhatsApp tenant's number ("+250…"): where a broker's later answer is sent.
  waPhone      String?   @unique
  memory       Json?
  /// The last search that showed homes — "new since your last visit" starts here.
  lastSearchAt DateTime?
  /// How this person first reached Mkan: tiktok (sent a post's home code) |
  /// k_page (the /k/<code> page's WhatsApp button) | organic. Set once.
  firstSource  String?
  /// The listing whose code opened their first chat, when there was one.
  firstRef     Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User?       @relation("AgentProfiles", fields: [userId], references: [id], onDelete: Cascade)
  tasks AgentTask[]

  @@index([updatedAt])
}

/**
 * One tenant search run by the rental agent (`/find`). The task, not the chat
 * tab, owns the work: a broker who answers hours later updates the task, and a
 * reload resumes it from `AgentEvent`. It belongs to an `AgentProfile`;
 * `sessionKey` (the raw cookie) only marks tasks from before profiles, until
 * their browser comes back and they are adopted.
 */
model AgentTask {
  id           String          @id @default(cuid())
  sessionKey   String?
  profileId    String?
  userId       String?
  /// The tenant's first words, for the ☰ chat list.
  title        String?         @db.VarChar(80)
  locale       String          @default("en")
  /// The tenant's words, in order — the agent re-reads them on every turn.
  messages     Json            @default("[]")
  /// Parsed, validated requirements (src/components/agent/requirements.ts).
  requirements Json?
  /// Ranked shortlist the panel renders: [{ listingId, score, reasons, cost }].
  shortlist    Json?
  status       AgentTaskStatus @default(RUNNING)
  /// The home code this chat opened with (K1234 → listing id), if any.
  refListingId Int?
  /// Where that code came from: tiktok | k_page | organic — the first-share funnel's attribution.
  refSource    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  profile        AgentProfile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  events         AgentEvent[]
  brokerRequests BrokerRequest[]
  demand         TenantRequest?

  @@index([sessionKey, createdAt])
  @@index([profileId, updatedAt])
  @@index([status, updatedAt])
  @@index([refSource, createdAt])
}

/// Claude API spend per UTC day and lane, priced from each response's `usage`:
/// the ledger behind the rental agent's hard monthly cap
/// (src/components/agent/claude.ts). Lanes: agent-read, agent-write,
/// agent-eval, and `capped` — a marker row written when the API reports the
/// credits are spent, so every instance stops until the month turns.
model ApiSpend {
  day              String
  lane             String
  usd              Decimal  @default(0) @db.Decimal(10, 5)
  calls            Int      @default(0)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@id([day, lane])
}

/**
 * One step of an agent task — the execution trace the panel renders. Every row
 * is something the system actually did or is waiting on; the panel never shows
 * a step that has no row. `status` separates done / running / waiting on a
 * person / failed / uncertain, as the panel must.
 */
model AgentEvent {
  id        Int      @id @default(autoincrement())
  taskId    String
  seq       Int
  kind      String
  status    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, seq])
}

enum BrokerRole {
  BROKER
  OWNER
}

/**
 * Who can speak for a home. One property is often advertised by several
 * brokers (the same flat in five TikTok videos from three accounts), so this
 * is many-to-many — `Listing.hostId` stays the account that owns the row.
 * Written by `scripts/crm/tiktok-mirror.ts` from Twenty `host` records.
 */
model ListingBroker {
  id        Int        @id @default(autoincrement())
  listingId Int
  userId    String
  role      BrokerRole @default(BROKER)
  /// The ad this broker posted for the home (a TikTok video URL).
  sourceUrl String?
  /// The directory entry for this broker (scripts/crm/brokers.ts).
  brokerId  String?
  createdAt DateTime   @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation("ListingBrokers", fields: [userId], references: [id], onDelete: Cascade)
  broker  Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  @@unique([listingId, userId])
  @@index([userId])
  @@index([brokerId])
}

enum BrokerRequestStatus {
  PENDING
  AVAILABLE
  RENTED
  NO_REPLY
}

/**
 * The agent asking a broker "is this home still available?" — and, once it is,
 * carrying the viewing: slots the broker proposes, the one the tenant picks,
 * the broker's confirmation (which creates the ListingVisit).
 * The broker answers on `/b/<token>` with one tap; only the token's sha256 is
 * stored. At most one request per (listing, broker) per 24 h, so a busy search
 * day never spams a broker. `need` is the tenant's requirement summary — no
 * name or phone until the tenant chooses a slot and consents.
 */
model BrokerRequest {
  id           String              @id @default(cuid())
  tokenHash    String              @unique
  listingId    Int
  brokerUserId String
  taskId       String?
  locale       String              @default("en")
  need         Json                @default("{}")
  status       BrokerRequestStatus @default(PENDING)
  /// "evolution" when the machine sent it, "manual" when a person must tap wa.me.
  channel      String              @default("manual")
  sentAt       DateTime?
  respondedAt  DateTime?
  expiresAt    DateTime
  /// Viewing times the broker offered (ISO strings).
  viewingSlots Json?
  chosenSlot   DateTime?
  tenantName   String?
  tenantPhone  String?
  /// The ListingVisit created when the broker confirmed the chosen slot.
  visitId      Int?
  /// When the tenant picked this home and said yes to asking (2026-11-01: no ask without it).
  consentAt    DateTime?
  /// What the broker told us about the deal: rent, months up front, deposit, commission, viewing fee, utilities, lease.
  terms        Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  listing Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  broker  User       @relation("BrokerRequests", fields: [brokerUserId], references: [id], onDelete: Cascade)
  task    AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([listingId, brokerUserId, createdAt])
  @@index([status, expiresAt])
  @@index([taskId])
}

enum BrokerKind {
  BROKER
  AGENCY
  LANDLORD
}

/**
 * The broker and agency directory: everyone who rents homes out in Kigali,
 * whether or not mkan has one of their homes. Built daily by
 * `scripts/crm/brokers.ts` from ListingBroker users, Twenty hosts, TikTok and
 * Facebook posters and Maps agencies, and mirrored to the Twenty `broker`
 * object. Coverage (districts, neighbourhoods, stays, price band) is derived
 * from the ads they posted; it is who the agent asks when nothing matches.
 */
model Broker {
  id               String     @id @default(cuid())
  kind             BrokerKind @default(BROKER)
  name             String
  userId           String?    @unique
  /// Normalised +250… numbers, the first is the one messaged.
  phones           String[]
  whatsapp         String?
  tiktokHandle     String?    @unique
  facebookUrl      String?
  website          String?
  email            String?
  districts        String[]
  neighbourhoods   String[]
  /// "night" | "month"
  stays            String[]
  /// RWF per month, 10th–90th percentile of their rents.
  priceMin         Int?
  priceMax         Int?
  listingsCount    Int        @default(0)
  /// Their newest ad anywhere.
  lastSeenAt       DateTime?
  lastAskedAt      DateTime?
  asks             Int        @default(0)
  answers          Int        @default(0)
  availableAnswers Int        @default(0)
  optOut           Boolean    @default(false)
  optOutAt         DateTime?
  twentyId         String?    @unique
  /// tiktok | facebook | web | maps | site | airbnb | whatsapp
  sources          String[]
  /// Zones served (kigali-zones slugs), derived from their ads unless a person set them in Twenty.
  zoneSlugs        String[]   @default([])
  /// Fields a person edited in Twenty; `crm:brokers` never overwrites them.
  lockedFields     String[]   @default([])
  /// When this row last went to Twenty — a later Twenty `updatedAt` is a person's edit.
  syncedAt         DateTime?
  /// Merged into another broker in Twenty; kept only until the merge is applied.
  mergedIntoId     String?
  /// RWF they ask to show a home (Kigali's usual is 5k), from their chats or replies.
  visitFee         Int?
  /// Median minutes they take to answer a WhatsApp message.
  replyMinutes     Int?
  /// Their last WhatsApp message to Mkan or to Abdout.
  lastReplyAt      DateTime?
  /// The person their ads say to call ("call Eric").
  contactName       String?
  /// RW | EN | FR | SW | AR — the language their ads are written in; write to them in it.
  preferredLanguage String?
  /// Every language their ads use, most used first.
  languages         String[]   @default([])
  /// Where Mkan stands with them (2026-11-01): NEW → INTRODUCED (our first message
  /// went out) → ACTIVE (they answered) → PARTNER (a share agreed); PAUSED; DO_NOT_CONTACT.
  relationship      BrokerRelationship @default(NEW)
  introducedAt      DateTime?
  /// The share of their commission Mkan earns on a tenant it brings (0.5 = half), or a flat amount.
  sharePct          Decimal?   @db.Decimal(5, 4)
  shareFlatRwf      Int?
  agreementNote     String?
  agreedAt          DateTime?
  /// The last message Mkan sent them — asks and replies alike.
  lastMessagedAt    DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user     User?             @relation("BrokerUser", fields: [userId], references: [id], onDelete: SetNull)
  listings ListingBroker[]
  messages OutboundMessage[]
  deals    Deal[]

  @@index([optOut, lastSeenAt])
}

enum BrokerRelationship {
  NEW
  INTRODUCED
  ACTIVE
  PARTNER
  PAUSED
  DO_NOT_CONTACT
}

enum DealStatus {
  VIEWING_BOOKED
  VIEWED
  SIGNED
  PAID
  LOST
}

/**
 * A tenant Mkan brought to a broker's home, from the booked viewing to the
 * signed lease and Mkan's share (2026-11-01). The three meet at the home —
 * tenant, broker, and the person from Mkan — and the lease is signed there
 * when it goes well. Mkan pays the viewing fee from its share of the broker's
 * commission; `mkanShare` is what the broker owes Mkan for this one.
 */
model Deal {
  id               String     @id @default(cuid())
  listingId        Int
  brokerId         String?
  visitId          Int?       @unique
  taskId           String?
  tenantName       String?
  tenantPhone      String?
  rentMonthly      Int?
  /// Paid at signing: rent in advance + deposit (+ commission when the tenant pays it).
  upfront          Int?
  brokerCommission Int?
  mkanShare        Int?
  viewingFeePaid   Int?
  status           DealStatus @default(VIEWING_BOOKED)
  notes            String?
  signedAt         DateTime?
  paidAt           DateTime?
  /// Mkan introduced tenant and broker directly (every deal until the 10th is paid — Abdout, 2026-11-07).
  introducedAt     DateTime?
  /// Intro follow-ups already queued: "tenant-24h", "tenant-7d", "broker-7d" (deal-intro.ts).
  introFollowUps   String[]   @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  listing Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  broker  Broker?       @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  visit   ListingVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([brokerId])
}

enum TenantRequestStatus {
  OPEN
  MATCHED
  CLOSED
  EXPIRED
}

/**
 * Demand the agent could not meet: a search with no home, kept for 14 days.
 * Brokers who cover the area are asked for a home (OutboundMessage
 * BROKER_ASK), and every new ad is matched against it daily
 * (scripts/crm/demand-match.ts). `phone` only after the tenant opted in.
 */
model TenantRequest {
  id                String              @id @default(cuid())
  taskId            String              @unique
  profileId         String?
  requirements      Json
  locale            String              @default("en")
  phone             String?
  optInAt           DateTime?
  status            TenantRequestStatus @default(OPEN)
  expiresAt         DateTime
  matchedListingIds Int[]
  lastMatchedAt     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  task     AgentTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messages OutboundMessage[]

  @@index([status, expiresAt])
}

enum OutboundKind {
  BROKER_ASK
  BROKER_REQUEST
  TENANT_ALERT
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/**
 * The WhatsApp outbox. The Worker cannot reach the Evolution instance on the
 * Mac, so it only writes rows here; `scripts/wa/outbox.ts` on the Mac drains
 * them under the caps (daily total, one per broker per day, quiet hours).
 * A BROKER_ASK carries the sha256 of the token behind `/b/d/<token>`, where
 * the broker submits a home for the request.
 */
model OutboundMessage {
  id               String         @id @default(cuid())
  kind             OutboundKind
  to               String
  body             String
  /// Who it is about, for the Slack fallback card.
  label            String?
  status           OutboundStatus @default(QUEUED)
  attempts         Int            @default(0)
  error            String?
  tokenHash        String?        @unique
  brokerId         String?
  tenantRequestId  String?
  /// BROKER_REQUEST: the BrokerRequest rows this message carries.
  brokerRequestIds String[]
  /// A home the broker submitted through the link.
  listingId        Int?
  sentAt           DateTime?
  createdAt        DateTime       @default(now())

  broker        Broker?        @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  tenantRequest TenantRequest? @relation(fields: [tenantRequestId], references: [id], onDelete: Cascade)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([brokerId, createdAt])
}

/// The WhatsApp bridge's small working state (src/components/agent/wa-state.ts):
/// seen message ids, STOP list, human holds, the agent's own sent ids, the
/// outbox lease and failure streak. One JSON value per key.
model WaState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// /monetize — the chatbot business, block by block (src/lib/monetize/).
/// One row per block per push: the Mac reads what the Worker cannot (run state
/// files, the scrape and post ledgers in scripts/crm/.data) and writes it here
/// hourly via `pnpm monetize:snapshot`. The page reads the latest row per block
/// and the last 14 days for trends.
model BlockSnapshot {
  id      String   @id @default(cuid())
  /// scrape | enhance | post | chat
  block   String
  at      DateTime @default(now())
  /// ok | warn | fail | stale — the run ledger's verdict for the block's jobs.
  status  String
  metrics Json
  summary String?

  @@index([block, at])
}

enum RevenueLine {
  COMMISSION
  VIEWING_FEE
  SUBSCRIPTION
  LICENSE
}

/// Money actually received — cash flow first. Commission and viewing fees are
/// entered when paid (cross-checked against Deal); broker subscriptions and
/// chatbot licences live only here.
model RevenueEntry {
  id         String      @id @default(cuid())
  line       RevenueLine
  amountRwf  Int
  receivedAt DateTime    @default(now())
  dealId     String?
  brokerId   String?
  customer   String?
  note       String?
  createdAt  DateTime    @default(now())

  @@index([line, receivedAt])
}

/// The self-improvement loop: one lever per block at a time, with a baseline
/// and a verdict measured from the snapshots, not from memory.
model Experiment {
  id         String    @id @default(cuid())
  block      String
  hypothesis String
  metric     String
  baseline   Float?
  target     Float?
  result     Float?
  /// running | won | lost | inconclusive
  verdict    String    @default("running")
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  note       String?

  @@index([block, startedAt])
}

/// /monetize sprint plan: one active WEEK and one active MONTH sprint, their tasks,
/// and the prompts that carry them out — pasted into Claude Code, then marked
/// processed on the page or with `pnpm sprint:done` (scripts/sprint.ts).
model Sprint {
  id        String         @id @default(cuid())
  /// WEEK | MONTH
  kind      String
  title     String
  goal      String?
  startsAt  DateTime
  endsAt    DateTime
  /// active | closed
  status    String         @default("active")
  /// Planned by the sprint cycle (scripts/sprint-cycle.ts), not by hand.
  auto      Boolean        @default(false)
  /// Written when the sprint closes: tasks done, the metrics before and after.
  retro     String?
  createdAt DateTime       @default(now())
  tasks     SprintTask[]
  prompts   SprintPrompt[]

  @@index([kind, startsAt])
}

model SprintTask {
  id       String         @id @default(cuid())
  sprintId String
  sprint   Sprint         @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  title    String
  /// scrape | enhance | post | chat
  block    String?
  order    Int            @default(0)
  done     Boolean        @default(false)
  doneAt   DateTime?
  note     String?
  prompts  SprintPrompt[]

  @@index([sprintId, order])
}

model SprintPrompt {
  id          String      @id @default(cuid())
  sprintId    String
  sprint      Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  taskId      String?
  task        SprintTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  order       Int         @default(0)
  text        String
  /// pending | running | processed | skipped | blocked ("needs you")
  status      String      @default("pending")
  processedAt DateTime?
  /// What the session that ran it reported.
  result      String?
  /// The success-metric key this prompt should move (src/lib/monetize/success.ts / metric keys).
  metric      String?
  /// That metric when the prompt was claimed; the lesson measures the delta.
  baseline    Float?
  /// When blocked: "<metric> <op> <value>" — the cycle sets it back to pending once true.
  unblockWhen String?
  blockedAt   DateTime?
  retries     Int         @default(0)
  /// Written by the sprint cycle, not by hand.
  auto        Boolean     @default(false)

  @@index([sprintId, order])
}

/// What the sprint loop learned: one row per finished prompt or closed sprint,
/// with the metric it aimed at before and after. The planner reads the latest
/// lessons before writing the next sprint (scripts/sprint-cycle.ts).
model SprintLesson {
  id        String    @id @default(cuid())
  promptId  String?
  sprintId  String?
  metric    String?
  before    Float?
  after     Float?
  /// moved | flat | worse | unknown — filled 24 h after the prompt is done.
  verdict   String    @default("unknown")
  text      String
  measureAt DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([verdict, measureAt])
}

/// One listing → one cleaned broker video → one TikTok post (2026-11-05).
/// The Mac's post lane writes the row as the video moves: PICKED (featured) →
/// CLEAN (text and logos stripped, nothing of ours burned on) or REJECTED →
/// POSTED or FAILED. The first-share funnel counts from here.
model TikTokPost {
  id            String    @id @default(cuid())
  listingId     Int
  /// The home code in the caption (K1234).
  ref           String
  sourceVideoId String?
  brokerHandle  String?
  /// PICKED | CLEAN | REJECTED | POSTED | FAILED
  status        String    @default("PICKED")
  reason        String?
  pickedAt      DateTime  @default(now())
  cleanAt       DateTime?
  postedAt      DateTime?
  tiktokUrl     String?
  tiktokId      String?
  views         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  /// TikTok's "favorites" (Studio / the video's collect count).
  saves         Int?
  /// Average watch time in seconds, and the share of viewers who watched to the end (0..1); Studio only.
  avgWatchSec   Float?
  completion    Float?
  /// Lever 4: the caption carried the follow ask. Null = posted before the tag, read back from the live caption.
  askFollow     Boolean?
  /// Lever 8: which caption line the WhatsApp line sits on (2 or 3), read from the live caption.
  waLine        Int?
  statsAt       DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([status, pickedAt])
  @@index([listingId, postedAt])
}
