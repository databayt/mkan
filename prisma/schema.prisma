// Short-term Booking payment record. Mirrors TransportPayment so the three
// payment verticals (lease / transport / booking) stay consistent. The
// reference flow (Bankak / Cashi / mobile money / bank transfer) parks at
// PendingVerification until an admin reconciles via verifyBookingPayment;
// the card flow (Stripe) advances to Paid via handleStripeWebhook.
model BookingPayment {
  id            Int                  @id @default(autoincrement())
  bookingId     Int
  amount        Float
  method        BookingPaymentMethod
  status        BookingPaymentStatus @default(Pending)
  intentId      String? // Stripe payment_intent id (card path)
  reference     String? // user-supplied wallet/bank reference
  transactionId String? // gateway-issued transaction id
  paidAt        DateTime?
  verifiedAt    DateTime? // admin reconciled the reference
  verifiedBy    String? // admin user id (loose ref, no FK)
  failureCode   String?
  refundedAt    DateTime?
  refundAmount  Float?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  booking       Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([intentId])
  @@index([reference])
}

enum BookingPaymentMethod {
  Card
  Bankak
  Cashi
  MobileMoney
  BankTransfer
  Cash
}

enum BookingPaymentStatus {
  Pending
  PendingVerification
  Paid
  Failed
  Refunded
  PartiallyRefunded
}

/// Fixed-window rate-limit counters — the Postgres fallback used when
/// Upstash Redis isn't configured. Key = "tier:identifier:windowStart";
/// rows expire with the window and are swept opportunistically.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

/// On-demand translation cache for dynamic DB content (listing titles,
/// descriptions, addresses…). Content is stored single-language (Arabic) and
/// the viewer's locale decides what they see — resolved LRU → this table →
/// Google Translate v2 (see src/components/translation/). Global (mkan is not
/// multi-tenant); manual rows (provider="manual") are never overwritten.
model Translation {
  id             String   @id @default(cuid())
  sourceText     String   @db.Text
  sourceLanguage String // "ar" | "en"
  targetLanguage String // "ar" | "en"
  translatedText String   @db.Text
  provider       String   @default("google")
  hitCount       Int      @default(0)
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceText, sourceLanguage, targetLanguage])
  @@index([sourceLanguage, targetLanguage])
  @@index([lastAccessedAt])
  @@map("translation_cache")
}
