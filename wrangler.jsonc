{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkan",
  "main": "cf/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  // String bindings become the container's env (cf/worker.js envVars) and win
  // over the baked env.json. The container reaches Neon over TCP (PrismaPg,
  // src/lib/db.ts) with a bounded pool, not the WebSocket driver.
  "vars": {
    "DATABASE_URL_ADAPTER": "pg"
  },
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "MkanContainer",
      "image": "./Dockerfile.cf",
      "max_instances": 1,
      "instance_type": "standard-1",
      // Next to the database: Neon is in AWS us-east-1. In London (where the
      // container landed on its own) every query cost ~96 ms and a /find turn
      // makes ~20 in a row; a Kigali request gains ~70 ms the other way.
      // Changing this starts a rollout that restarts the instance (2026-10-24).
      "constraints": {
        "regions": ["ENAM"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MKAN",
        "class_name": "MkanContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MkanContainer"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 2 * * *",
      "0 1 1 * *",
      "0 3 * * *",
      "0 4 * * *",
      "0 5 * * *",
      "0 * * * *",
      "*/2 * * * *"
    ]
  },
  // WHATSAPP: the Evolution bridge inside the hogwarts container, through its
  // private WhatsappBridge entrypoint (hogwarts cf/worker.js). mkan keeps its
  // own instance there ("mkan"); cf/worker.js forwards /__wa/* to it.
  "services": [
    { "binding": "WHATSAPP", "service": "hogwarts", "entrypoint": "WhatsappBridge" }
  ],
  "routes": [
    {
      "pattern": "mkan.sd/*",
      "zone_name": "mkan.sd"
    },
    {
      "pattern": "*.mkan.sd/*",
      "zone_name": "mkan.sd"
    }
  ]
}
