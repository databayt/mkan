{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkan",
  "main": "cf/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  // String bindings become the container's env (cf/worker.js envVars) and win
  // over the baked env.json. The container reaches Neon over TCP (PrismaPg,
  // src/lib/db.ts) with a bounded pool, not the WebSocket driver.
  "vars": {
    "DATABASE_URL_ADAPTER": "pg"
  },
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "MkanContainer",
      "image": "./Dockerfile.cf",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MKAN",
        "class_name": "MkanContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MkanContainer"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 2 * * *",
      "0 1 1 * *",
      "0 3 * * *",
      "0 4 * * *",
      "0 5 * * *",
      "0 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "mkan.sd/*",
      "zone_name": "mkan.sd"
    },
    {
      "pattern": "*.mkan.sd/*",
      "zone_name": "mkan.sd"
    }
  ]
}
