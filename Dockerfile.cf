# mkan on Cloudflare Containers — image over a prebuilt Next standalone output.
# The build happens on the Mac (scripts/deploy-cloudflare.sh); nothing compiles here.
# The repo's other Dockerfile builds inside the container and is left untouched.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NODE_OPTIONS=--max-old-space-size=3072 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY .next/standalone ./
COPY .next/static ./.next/static
COPY public ./public
COPY cf/entry.cjs ./entry.cjs
EXPOSE 3000
CMD ["node", "entry.cjs"]
